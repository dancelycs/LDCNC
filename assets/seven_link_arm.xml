<mujoco model="seven_link_arm">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.01" gravity="0 0 -9.81" integrator="RK4"/>
  <default>
    <joint limited="true" range="-2.6 2.6" damping="0.12" armature="0.02"/>
    <geom type="capsule" size="0.025" density="520" rgba="0.25 0.48 0.78 1"/>
    <motor ctrllimited="true" ctrlrange="-45 45"/>
  </default>
  <worldbody>
    <light pos="2 -2 3" dir="-1 1 -1"/>
    <geom type="plane" size="3 3 0.1" rgba="0.9 0.9 0.9 1"/>
    <body name="link1" pos="0 0 0.08">
      <joint name="joint1" type="hinge" axis="0 0 1"/>
      <geom fromto="0 0 0 0 0 0.30"/>
      <body name="link2" pos="0 0 0.30">
        <joint name="joint2" type="hinge" axis="0 1 0"/>
        <geom fromto="0 0 0 0 0 0.30"/>
        <body name="link3" pos="0 0 0.30">
          <joint name="joint3" type="hinge" axis="1 0 0"/>
          <geom fromto="0 0 0 0 0 0.28"/>
          <body name="link4" pos="0 0 0.28">
            <joint name="joint4" type="hinge" axis="0 1 0"/>
            <geom fromto="0 0 0 0 0 0.26"/>
            <body name="link5" pos="0 0 0.26">
              <joint name="joint5" type="hinge" axis="1 0 0"/>
              <geom fromto="0 0 0 0 0 0.24"/>
              <body name="link6" pos="0 0 0.24">
                <joint name="joint6" type="hinge" axis="0 1 0"/>
                <geom fromto="0 0 0 0 0 0.22"/>
                <body name="link7" pos="0 0 0.22">
                  <joint name="joint7" type="hinge" axis="1 0 0"/>
                  <geom fromto="0 0 0 0 0 0.20"/>
                  <body name="payload" pos="0 0 0.20">
                    <geom name="payload_geom" type="sphere" size="0.055" mass="1.0" rgba="0.85 0.25 0.18 1"/>
                    <site name="end_effector" size="0.025" rgba="0.1 0.8 0.2 1"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor joint="joint1"/><motor joint="joint2"/><motor joint="joint3"/>
    <motor joint="joint4"/><motor joint="joint5"/><motor joint="joint6"/>
    <motor joint="joint7"/>
  </actuator>
</mujoco>
